# DocForge Phase 0 — copy to .env and adjust. Never commit real secrets.

# Postgres
POSTGRES_USER=docforge
POSTGRES_PASSWORD=docforge_dev_change_me
POSTGRES_DB=docforge
DATABASE_URL=postgresql+psycopg://docforge:docforge_dev_change_me@postgres:5432/docforge

# Redis / Arq
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible)
MINIO_ROOT_USER=docforge_minio
MINIO_ROOT_PASSWORD=docforge_minio_change_me
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=docforge
MINIO_PUBLIC_URL=http://localhost:9000

# JWT auth (generate a long random string for production)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=admin_change_me

# Web
VITE_API_URL=http://localhost:8000

# Optional Ollama (compose profile: ollama)
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDINGS_PROVIDER=local
# Local embeddings note: use Ollama embeddings (e.g. nomic-embed-text) or
# sentence-transformers in the worker for later retrieval phases.

# Phase 1 — LLM + git providers
LLM_PROVIDER=mock
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
INLINE_JOBS=true
ARTIFACT_DIR=/tmp/docforge-artifacts
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITLAB_TOKEN=
GITLAB_API_BASE=https://gitlab.com/api/v4
# TEMPLATES_ROOT=/templates
