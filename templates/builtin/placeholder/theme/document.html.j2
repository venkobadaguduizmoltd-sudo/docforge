<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ doc_title }}</title>
  <style>
    :root {
      --ink: #16201c;
      --muted: #5a6c62;
      --accent: #0f766e;
      --canvas: #f4f6f1;
      --border: #d2dcd6;
    }
    body {
      margin: 0;
      font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(900px 400px at 0% 0%, rgb(15 118 110 / 0.12), transparent 55%),
        var(--canvas);
      line-height: 1.55;
    }
    main {
      max-width: 52rem;
      margin: 0 auto;
      padding: 2.5rem 1.5rem 4rem;
    }
    h1 {
      font-size: 2rem;
      letter-spacing: -0.02em;
      margin-bottom: 0.25rem;
    }
    .eyebrow {
      font-family: ui-monospace, monospace;
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--muted);
    }
    section {
      margin-top: 2rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }
    h2 {
      color: var(--accent);
      font-size: 1.35rem;
      margin: 0 0 0.75rem;
    }
    ul { padding-left: 1.2rem; }
    .notes {
      color: var(--muted);
      font-style: italic;
    }
    code, .code-ref {
      font-family: ui-monospace, monospace;
      font-size: 0.9em;
    }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">DocForge</p>
    <h1>{{ doc_title }}</h1>
    {% for section in sections %}
    <section id="{{ section.id }}">
      <h2>{{ section.title }}</h2>
      <p>{{ section.summary }}</p>
      {% if section.bullets %}
      <ul>
        {% for bullet in section.bullets %}
        <li>{{ bullet }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if section.code_refs %}
      <p><strong>Code references</strong></p>
      <ul>
        {% for ref in section.code_refs %}
        <li class="code-ref">{{ ref }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if section.notes %}
      <p class="notes">{{ section.notes }}</p>
      {% endif %}
    </section>
    {% endfor %}
  </main>
</body>
</html>
